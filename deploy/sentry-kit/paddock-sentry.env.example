# Paddock Sentry: first-boot settings.
# Copy this file to the BOOT partition of the SD card (the drive that appears as
# "bootfs" or "boot" when you plug the card into your computer) and name it
#   paddock-sentry.env
# Then put the card in the Pi and power it on. Nothing else to type.
#
# Create the token in Paddock: Sensors > Add sensor. It works once and expires.

# Where your Paddock server accepts sensors (the otdiscovery port, behind TLS).
PADDOCK_SERVER=https://paddock.example.com:8101

# One-time enrollment token from the dashboard. The installer deletes it from this
# file after it is used.
PADDOCK_ENROLL_TOKEN=pet_00000000_replace-me

# Optional -----------------------------------------------------------------------
# Force the capture (mirror) port. Leave unset to auto-detect: the wired port that
# has a link and no IP address.
# PADDOCK_SENTRY_IFACE=eth1
# Name shown in the dashboard (default: the device hostname).
# PADDOCK_SENTRY_NAME=lobby-1
# Only for a trusted lab network with no TLS (the token and credential would
# cross the network in clear text). Leave unset on any real network.
# PADDOCK_ALLOW_HTTP=1
