# paddock — environment template
# =============================================================================
# Copy to `.env` and fill in real values before running the HARDENED profile:
#       cp .env.example .env
#       # edit .env, then:
#       docker compose -f docker-compose.yml up -d --build
#
# `.env` is gitignored. NEVER commit real secrets. These values are read by
# docker-compose via ${VAR} substitution (compose auto-loads `.env`).
# Generate strong values, e.g.:  openssl rand -base64 24
# =============================================================================

# Postgres superuser password for the `asm` role. Used by postgres itself and
# embedded in every service's DATABASE_URL.
POSTGRES_PASSWORD=change-me-postgres

# Password for `paddock_app`, the NON-superuser role the orchestrator connects
# as (Postgres row-level security does not apply to superusers). Optional:
# falls back to POSTGRES_PASSWORD. Set on first DB init by schema/100_app_role.sh.
PADDOCK_APP_DB_PASSWORD=change-me-paddock-app

# Neo4j password (the NEO4J_AUTH pair is neo4j/<this>). Used by neo4j and the
# graphsync service.
NEO4J_PASSWORD=change-me-neo4j

# First-boot orchestrator admin password. On startup, if the seeded `admin`
# user has no password hash, the orchestrator sets it from this value (once).
# Leave unset to have the orchestrator generate one and log it a single time.
# Never ship a known/default admin credential.
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-bootstrap

# Anthropic API key for the `brain` (LLM triage / NL-query) service. Optional:
# brain degrades gracefully when absent. Keep this secret out of logs.
# You do not have to edit this file: an admin can paste a key into
# Settings > System > AI features instead (stored encrypted; it takes priority).
ANTHROPIC_API_KEY=

# ---- optional overrides (defaults live in docker-compose.yml) ---------------
# AUTH_MODE: `enforce` (hardened default) or `dev` (synthetic admin; the dev
# override sets this to `dev` automatically). Do NOT set `dev` in production.
# AUTH_MODE=enforce
# ALLOW_NO_AUTH=false

# ---- Paddock Sentry (passive network sensors) -------------------------------
# Comma-separated tokens sensors use to post to otdiscovery :8101/ingest.
# The hardened profile refuses ALL sensor data until this is set.
# Generate one per sensor:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# SENTRY_TOKENS=

# ---- Integrations (Slack, Teams, PagerDuty, webhooks, email) -----------------
# 32-byte key that encrypts integration credentials at rest (AES-256-GCM).
# REQUIRED in the hardened profile before saving any integration secret.
# Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotate: move the old value to PADDOCK_SECRET_KEY_OLD (comma-separated) and set a new one.
PADDOCK_SECRET_KEY=
# PADDOCK_SECRET_KEY_OLD=
# Public dashboard URL used for "Open in Paddock" links in notifications.
# PADDOCK_DASHBOARD_URL=http://localhost:3000
# ---- Integrations: context SOURCE connectors (AWS, Defender/Intune, Falcon, CMDB)
# Enabled SOURCE integrations are pulled on their own `sync_interval_minutes`
# by the orchestrator scheduler (read-only). Set to 0 to pause scheduled pulls
# (manual "sync now" still works). See docs/INTEGRATIONS-CONTEXT.md.
# PADDOCK_SOURCE_SYNC=1
# ---- Editions / licensing (optional; see docs/EDITIONS.md) -------------------
# Unset = Community edition: everything in the open-source tree, no limits.
# A signed key can also be uploaded at runtime (POST /v1/license, admin).
# PADDOCK_LICENSE_KEY=PDK1....
# Extra trusted vendor public keys (base64, comma-separated), e.g. a test lab.
# PADDOCK_LICENSE_PUBLIC_KEYS=
# ---- Operations (docs/OPERATIONS.md) ----------------------------------------
# Bearer token Prometheus must send to GET /metrics on the orchestrator (and
# otdiscovery). Unset: /metrics is 404 under AUTH_MODE=enforce.
# METRICS_TOKEN=
# Schema migrations run in the `migrate` one-shot and again (no-op) on
# orchestrator startup. Set false to rely on the one-shot / Helm Job only.
# MIGRATE_ON_STARTUP=true
# Data retention (days; 0 disables a table). audit_log is never purged.
# RETENTION_SCOPE_DECISIONS_DAYS=180
# RETENTION_OUTBOUND_LOG_DAYS=180
# RETENTION_INTEGRATION_DELIVERIES_DAYS=90
# RETENTION_OBSERVATIONS_DAYS=30
# Backups (scripts/backup.sh): none | age | gpg
# BACKUP_ENCRYPT=age
# AGE_RECIPIENT=age1...
# BACKUP_RETENTION_DAYS=14
# ---- Enterprise identity: SSO (OIDC / SAML) + SCIM (see docs/SSO.md) --------
# Public URL of the orchestrator as browsers and the IdP reach it. Redirect
# URIs, the SAML ACS + entity ID and the SCIM base URL derive from this (never
# from the request Host header). Must be https:// in production.
# SSO_BASE_URL=https://paddock.example.com
# Where the dashboard lives; SSO finishes at <this>/sso/callback.
# SSO_DASHBOARD_URL=https://paddock.example.com
# Key that encrypts IdP client secrets at rest (32 bytes, urlsafe-base64).
# REQUIRED in enforce mode before an OIDC client secret can be saved.
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# PADDOCK_SECRET_KEY=
# Lifetimes (seconds): start->callback window, one-time SPA code, clock skew.
# SSO_STATE_TTL_SEC=600
# SSO_CODE_TTL_SEC=60
# SSO_CLOCK_SKEW_SEC=60
# ---- worker fleet credential + scope proof (lite + hardened profiles) -------
# With AUTH_MODE=enforce the workers authenticate to the orchestrator with this
# shared key (X-API-Key). `make lite` generates one into .env if it is missing.
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# SERVICE_API_KEY=
# Scope entries authorise nothing until ownership is proven (DNS TXT / HTTPS
# file for domains, a recorded attestation for IP ranges). Default true in the
# hardened + lite profiles, false in the dev override.
# REQUIRE_SCOPE_PROOF=true
# ---- Reports (executive report, weekly digest, compliance packs) ------------
# Name on report covers and digests; dashboard URL for digest deep links.
# REPORTS_ORG_NAME=Your organization
# REPORTS_PUBLIC_URL=https://paddock.example.com
# REPORTS_PAGE_SIZE=A4                 # or Letter
# Weekly digest (emitted as a report.digest integrations event), UTC.
# REPORTS_DIGEST_ENABLED=true
# REPORTS_DIGEST_WEEKDAY=0             # 0 = Monday
# REPORTS_DIGEST_HOUR=8
# REPORTS_DIGEST_CLEARANCE=internal    # highest classification a digest may contain
# ---- Enterprise trust: keyed + anchored audit chain, tenancy ----------------
# HMAC key for the audit hash chain. Keep it OUTSIDE the database (this env, a
# docker secret via AUDIT_HMAC_KEY_FILE, or a KMS-decrypted file). Rotation:
# move the old key to AUDIT_HMAC_PREVIOUS_KEYS. Generate: openssl rand -hex 32
# AUDIT_HMAC_KEY=
# AUDIT_HMAC_PREVIOUS_KEYS=
# Anchor the chain head hourly to append-only storage: file,s3,webhook
# AUDIT_ANCHOR_SINKS=s3        # `file` needs a writable volume at AUDIT_ANCHOR_FILE
# AUDIT_ANCHOR_S3_BUCKET=      # bucket with Object Lock enabled (pip extra [s3])
# AUDIT_ANCHOR_WEBHOOK_URL=
# Multi-tenant deployments: no tenant in context => no rows (fail closed).
# TENANCY_STRICT=false

# Password for the least-privilege roles the compute services connect as
# (paddock_svc_intel, paddock_svc_brain, ...; schema/029_service_tenancy.sql).
# Override one service with PADDOCK_SVC_<NAME>_DB_PASSWORD. Falls back to
# PADDOCK_APP_DB_PASSWORD, then POSTGRES_PASSWORD -- set a DISTINCT value so a
# compromised service never learns the owner password.
PADDOCK_SERVICES_DB_PASSWORD=change-me-paddock-services
# Multi-tenant deployments: no implicit default tenant anywhere (docs/trust/TENANCY.md).
# TENANCY_STRICT=true
