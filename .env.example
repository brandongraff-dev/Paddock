# paddock — environment template
# =============================================================================
# Copy to `.env` and fill in real values before running the HARDENED profile:
#       cp .env.example .env
#       # edit .env, then:
#       docker compose -f docker-compose.yml up -d --build
#
# `.env` is gitignored. NEVER commit real secrets. These values are read by
# docker-compose via ${VAR} substitution (compose auto-loads `.env`).
# Generate strong values, e.g.:  openssl rand -base64 24
# =============================================================================

# Postgres superuser password for the `asm` role. Used by postgres itself and
# embedded in every service's DATABASE_URL.
POSTGRES_PASSWORD=change-me-postgres

# Neo4j password (the NEO4J_AUTH pair is neo4j/<this>). Used by neo4j and the
# graphsync service.
NEO4J_PASSWORD=change-me-neo4j

# First-boot orchestrator admin password. On startup, if the seeded `admin`
# user has no password hash, the orchestrator sets it from this value (once).
# Leave unset to have the orchestrator generate one and log it a single time.
# Never ship a known/default admin credential.
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-bootstrap

# Anthropic API key for the `brain` (LLM triage / NL-query) service. Optional:
# brain degrades gracefully when absent. Keep this secret out of logs.
ANTHROPIC_API_KEY=

# ---- optional overrides (defaults live in docker-compose.yml) ---------------
# AUTH_MODE: `enforce` (hardened default) or `dev` (synthetic admin; the dev
# override sets this to `dev` automatically). Do NOT set `dev` in production.
# AUTH_MODE=enforce
# ALLOW_NO_AUTH=false

# ---- Paddock Sentry (passive network sensors) -------------------------------
# Comma-separated tokens sensors use to post to otdiscovery :8101/ingest.
# The hardened profile refuses ALL sensor data until this is set.
# Generate one per sensor:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# SENTRY_TOKENS=

# ---- Integrations (Slack, Teams, PagerDuty, webhooks, email) -----------------
# 32-byte key that encrypts integration credentials at rest (AES-256-GCM).
# REQUIRED in the hardened profile before saving any integration secret.
# Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotate: move the old value to PADDOCK_SECRET_KEY_OLD (comma-separated) and set a new one.
PADDOCK_SECRET_KEY=
# PADDOCK_SECRET_KEY_OLD=
# Public dashboard URL used for "Open in Paddock" links in notifications.
# PADDOCK_DASHBOARD_URL=http://localhost:3000
# ---- Integrations: context SOURCE connectors (AWS, Defender/Intune, Falcon, CMDB)
# Enabled SOURCE integrations are pulled on their own `sync_interval_minutes`
# by the orchestrator scheduler (read-only). Set to 0 to pause scheduled pulls
# (manual "sync now" still works). See docs/INTEGRATIONS-CONTEXT.md.
# PADDOCK_SOURCE_SYNC=1
