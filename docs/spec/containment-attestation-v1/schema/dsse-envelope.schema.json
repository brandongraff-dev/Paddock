{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://paddock.dev/spec/containment-attestation/v1/dsse-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Plain JSON, at most 512 KiB, not required to be canonical. Exactly one signature. The signature covers the DSSE pre-authentication encoding of payloadType and the decoded payload bytes.",
  "properties": {
    "payload": {
      "description": "canonical standard base64 of the PCJ payload bytes",
      "maxLength": 349528,
      "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "payloadType": {
      "enum": [
        "application/vnd.in-toto+json",
        "application/vnd.paddock.key-cert+json",
        "application/vnd.paddock.revocation-list+json"
      ]
    },
    "signatures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "keyid": {
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          },
          "sig": {
            "description": "canonical standard base64 of 64 bytes",
            "pattern": "^[A-Za-z0-9+/]{86}==$",
            "type": "string"
          }
        },
        "required": [
          "keyid",
          "sig"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "payloadType",
    "payload",
    "signatures"
  ],
  "title": "DSSE envelope",
  "type": "object"
}
